# Create an OAuth 2.0 Web application in Google Cloud Console and add this redirect URI:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# Optional: the Spring backend URL used by the Next.js proxy.
PRIMER_API_URL=http://localhost:8080
